# For local testing with `vercel dev`, copy this file to `.env.local`.
# In production, set these in the Vercel dashboard instead:
# Project → Settings → Environment Variables. Vercel does not read
# this file (or .env.local) when deployed — only during local dev.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/horizon_gate?retryWrites=true&w=majority

# ------------------------------------------------------------------
# Admin login (replaces the old shared ADMIN_PASSWORD approach)
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@horizongate.edu
# A bcrypt HASH of your password, not the password itself. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-real-password', 10))"
# (run that locally after `npm install` — never commit your real password anywhere)
ADMIN_PASSWORD_HASH=
# Any long random string, used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------------------------
# Google Sheets — admission registration storage (see README for full
# service-account setup steps)
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the service account's private key here, including the
# -----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY----- lines.
# When pasting into Vercel's dashboard, keep it as one value — Vercel
# handles the newlines fine. If setting it in a raw .env file instead,
# wrap it in quotes and use \n for line breaks.
GOOGLE_PRIVATE_KEY=
# The long ID from your Sheet's URL:
# docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Optional: outgoing email for form confirmations. Leave blank to skip email
# sending entirely — forms still work and still save to the database/sheet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=admissions@horizongate.edu
NOTIFY_EMAIL_TO=admissions@horizongate.edu
